<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="7dp"
    android:paddingEnd="7dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="#17191E"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/search_button"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginEnd="7dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="⌕"
        android:textColor="#80BEFF"
        android:textSize="27sp"
        android:maxLines="1"
        android:background="@drawable/widget_search_border" />

    <TextView
        android:id="@+id/add_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:text="＋"
        android:textColor="#80BEFF"
        android:textSize="25sp"
        android:background="@drawable/widget_circle_button" />

    <TextView
        android:id="@+id/ledger_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:text="▤"
        android:textColor="#80BEFF"
        android:textSize="20sp"
        android:background="@drawable/widget_circle_button" />

    <TextView
        android:id="@+id/share_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:text="↗"
        android:textColor="#80BEFF"
        android:textSize="22sp"
        android:background="@drawable/widget_circle_button" />

    <TextView
        android:id="@+id/info_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="ⓘ"
        android:textColor="#80BEFF"
        android:textSize="22sp"
        android:background="@drawable/widget_circle_button" />

    <TextView
        android:id="@+id/widget_result_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/widget_result_price"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="" />

</LinearLayout>
