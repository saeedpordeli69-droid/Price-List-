<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/widget_search_border">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        android:text="PriceYar"
        android:textColor="#F5FAFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/search_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_search_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌕\nجستجوی کالا"
            android:textColor="#F5FAFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/add_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_search_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="＋\nافزودن کالا"
            android:textColor="#55D8FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ledger_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_search_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▤\nدفتر حساب"
            android:textColor="#DCEBFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/share_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_search_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⇧\nارسال لیست"
            android:textColor="#DCEBFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
