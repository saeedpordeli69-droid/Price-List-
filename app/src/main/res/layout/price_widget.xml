<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="4dp"
    android:background="#171A20">

    <!-- Search -->
    <TextView
        android:id="@+id/search_button"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_search_border"
        android:gravity="center_vertical|start"
        android:paddingStart="12dp"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="#99FFFFFF"
        android:text=""
        android:clickable="true"
        android:focusable="true" />

    <!-- Add -->
    <TextView
        android:id="@+id/add_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/widget_circle_button"
        android:gravity="center"
        android:drawableTop="@drawable/ic_add"
        android:drawableTint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <!-- Ledger -->
    <TextView
        android:id="@+id/ledger_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/widget_circle_button"
        android:gravity="center"
        android:drawableTop="@drawable/ic_ledger"
        android:drawableTint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <!-- Share -->
    <TextView
        android:id="@+id/share_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/widget_circle_button"
        android:gravity="center"
        android:drawableTop="@drawable/ic_share"
        android:drawableTint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <!-- Info -->
    <TextView
        android:id="@+id/info_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_circle_button"
        android:gravity="center"
        android:drawableTop="@drawable/ic_info"
        android:drawableTint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hidden result fields required by the app -->
    <TextView
        android:id="@+id/widget_result_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_result_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
