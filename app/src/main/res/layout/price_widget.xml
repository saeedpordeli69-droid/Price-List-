<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#303134"
    android:padding="8dp">

    <!-- کادر جستجو -->
    <LinearLayout
        android:id="@+id/widgetSearchArea"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_search_line"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/widgetDollarIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_dollar"
            android:contentDescription="PriceYar" />

        <ImageView
            android:id="@+id/widgetSearchIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_search"
            android:tint="#B8BBC0"
            android:contentDescription="جستجو" />

        <TextView
            android:id="@+id/widgetSearchText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="جستجوی کالا"
            android:textColor="#E8EAED"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- میانبرها -->
    <LinearLayout
        android:id="@+id/widgetShortcuts"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widgetAddButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#E8EAED"
            android:textSize="25sp"
            android:background="@drawable/widget_circle_button" />

        <TextView
            android:id="@+id/widgetHelpButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#E8EAED"
            android:textSize="21sp"
            android:background="@drawable/widget_circle_button" />

        <TextView
            android:id="@+id/widgetShareButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="☷"
            android:textColor="#E8EAED"
            android:textSize="22sp"
            android:background="@drawable/widget_circle_button" />

    </LinearLayout>

</LinearLayout>
