<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal|center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Search -->
    <TextView
        android:id="@+id/search_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_search_border"
        android:gravity="center_vertical|start"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:drawableTint="#99FFFFFF"
        android:text="جستجوی کالا..."
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:clickable="true"
        android:focusable="true" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Add -->
        <FrameLayout
            android:id="@+id/add_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_circle_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:contentDescription="افزودن کالا" />
        </FrameLayout>

        <!-- Ledger -->
        <FrameLayout
            android:id="@+id/ledger_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_circle_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ledger"
                android:contentDescription="دفتر حساب" />
        </FrameLayout>

        <!-- Share -->
        <FrameLayout
            android:id="@+id/share_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_circle_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_share"
                android:contentDescription="ارسال لیست" />
        </FrameLayout>

        <!-- Info -->
        <FrameLayout
            android:id="@+id/info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_circle_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_info"
                android:contentDescription="اطلاعات" />
        </FrameLayout>

    </LinearLayout>

    <!-- Hidden result fields -->
    <TextView
        android:id="@+id/widget_result_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text=""
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_result_price"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text=""
        android:visibility="gone" />

</LinearLayout>
