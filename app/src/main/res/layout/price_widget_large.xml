<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#202124">

    <TextView
        android:id="@+id/search_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="جستجوی کالا"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/widget_search_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/add_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="＋ افزودن کالا"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/widget_circle_button" />

        <TextView
            android:id="@+id/ledger_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="دفتر حساب"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/widget_circle_button" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/share_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="ارسال لیست"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/widget_circle_button" />

        <TextView
            android:id="@+id/info_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="ℹ اطلاعات"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/widget_circle_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_result_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="PriceYar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_result_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
